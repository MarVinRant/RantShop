<section class="placeholder-panel" data-scaffold="placeholder">
  <p class="eyebrow">RantiShop · prévia técnica</p>
  <h1>{{ section.settings.heading }}</h1>
  <p>{{ section.settings.description }}</p>
  <p class="scaffold-note">Imagem, produtos, preço, estoque e fornecedor: TODO — não disponíveis nesta etapa.</p>
</section>
{% schema %}
{
  "name": "Painel placeholder",
  "settings": [
    {"type":"text","id":"heading","label":"Título","default":"Tudo para transformar seu lar."},
    {"type":"textarea","id":"description","label":"Descrição","default":"Estrutura visual preparada para futura integração do catálogo homologado."}
  ],
  "presets": [{"name":"Painel placeholder"}]
}
{% endschema %}
